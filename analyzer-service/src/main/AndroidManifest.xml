<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!--
            Proceso de análisis AISLADO.
            isolatedProcess=true: Android lo ejecuta con un UID aleatorio y un dominio SELinux restringido,
            sin ningún permiso de la app (incluido INTERNET) y sin acceso a su almacenamiento.
            Solo puede usar los descriptores de archivo que el proceso principal le entrega por Binder.
        -->
        <service
            android:name="com.funcodestudiocb.analyzer.service.AnalyzerService"
            android:exported="false"
            android:isolatedProcess="true"
            android:process=":analyzer" />
    </application>

</manifest>
