<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Internet solo para el actualizador de la base de vulnerabilidades (Fase 7), en el proceso principal y cuando
        el usuario lo pide en Ajustes: descarga datos públicos de OSV y endoflife.date (únicos servidores admitidos,
        solo HTTPS) y no envía nada del código analizado. El proceso de análisis aislado no tiene red aunque la app
        tenga el permiso: el diagnóstico de aislamiento lo comprueba.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Servicio en primer plano mientras dura un análisis, con notificación de progreso. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".FuncodeApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Funcode"
        tools:targetApi="33">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- "Abrir con…" desde un gestor de archivos. -->
            <intent-filter android:label="@string/open_with_label">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-zip-compressed" />
                <data android:mimeType="application/vnd.rar" />
                <data android:mimeType="application/x-rar-compressed" />
                <data android:mimeType="application/x-rar" />
            </intent-filter>
            <!-- "Compartir" desde otra app (muchas marcan los RAR como binario genérico). -->
            <intent-filter android:label="@string/open_with_label">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-zip-compressed" />
                <data android:mimeType="application/vnd.rar" />
                <data android:mimeType="application/x-rar-compressed" />
                <data android:mimeType="application/x-rar" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
        </activity>

        <service
            android:name=".analysis.AnalysisForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Descarga de la base de vulnerabilidades, solo mientras el usuario la actualiza. -->
        <service
            android:name=".vulndb.VulnDbUpdateService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Compartir un informe por acción explícita del usuario: solo la carpeta temporal de informes, sin escritura. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.informes"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/report_paths" />
        </provider>

        <!-- Sin EmojiCompat: podría pedir fuentes descargables a Google Play Services. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                tools:node="remove" />
        </provider>
    </application>

</manifest>
